# --- Instagram (ver docs/META_SETUP.md) ---
# Token EAA... generado en Meta (Casos de uso → Instagram → API setup with Unified login → Generar token)
IG_TOKEN=
# ID de la cuenta de Instagram (@sebacoler)
IG_USER_ID=17841402384432139
# "unificado" para apps nuevas de Meta (la nuestra); "instagram" solo para apps antiguas
IG_LOGIN=unificado
IG_API_VERSION=v26.0

# --- Supabase (proyecto ContentGenerator) ---
SUPABASE_URL=https://dntgjzhbzitdlegjpghe.supabase.co
# Settings → API Keys → secret key (sb_secret_...). Nunca la pegues en un chat ni la subas a GitHub.
SUPABASE_SERVICE_KEY=

# --- Ajustes del test ---
IGT_ZONA=Europe/Madrid
# Alcance mínimo para que una variante cuente en la comparación
IGT_MIN_REACH=300
# Ventaja mínima en skip rate (puntos) para declarar ganador
IGT_MARGEN_SKIP_PTS=5
# A qué edad se comparan las variantes (24, 72 o 168 horas)
IGT_COMPARAR_A_LAS_H=72
# Modo paralelo: minutos entre variantes del mismo día (menos de 60 arriesga que IG lo trate como contenido repetido)
IGT_ESPACIADO_PARALELO_MIN=60
IGT_MAX_TRIALS_24H=15

# --- Avisos al móvil (opcional): instalá la app ntfy y suscribite a este tema ---
IGT_NTFY_TOPIC=
